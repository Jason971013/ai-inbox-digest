# 测试环境配置示例
# 复制此文件为 .env.local 或 .env.test

# Gemini API配置（无真实API密钥时自动启用Mock模式）
# 当以下密钥缺失或为占位符时，系统自动使用Mock分支
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Playwright测试配置
# 本地测试：http://localhost:3000
# Preview环境：https://your-preview-domain.vercel.app
# CI环境：http://localhost:3000
BASE_URL=http://localhost:3000

# 环境标识
NODE_ENV=test

# Mock模式说明：
# 1. 删除或留空GEMINI_API_KEY → 自动启用Mock模式
# 2. Mock模式提供完整的测试数据，无需真实API调用
# 3. 所有接口返回200状态码，不抛500错误
# 4. 响应包含trace_id和using_mock标识

# 半真半假配置：
# 1. 只填写GEMINI_API_KEY → AI服务走真实，其他走Mock
# 2. 系统自动识别并标记using_mock状态
# 3. 确保测试稳定通过

# Preview环境测试：
# 1. 设置 BASE_URL=https://your-preview-domain.vercel.app
# 2. 确保Preview环境的环境变量配置正确
# 3. 运行：BASE_URL=https://your-preview-domain.vercel.app npm run test:all

# 本地测试：
# 1. 设置 BASE_URL=http://localhost:3000
# 2. 运行：npm run test:all

# CI环境：
# 1. 自动使用 http://localhost:3000
# 2. 自动启用Mock模式

# 获取Gemini API Key：
# 1. 访问 https://makersuite.google.com/app/apikey
# 2. 创建新的API密钥
# 3. 复制密钥到GEMINI_API_KEY环境变量
# 4. 注意：不要将密钥提交到代码仓库


